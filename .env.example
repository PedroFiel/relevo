# Copie para .env  (cp .env.example .env)
DATABASE_URL=postgresql+psycopg://relevo:relevo@localhost:5432/relevo
# Testes: vazio = mesmo servidor do DATABASE_URL, base relevo_test (criada sozinha)
# TEST_DATABASE_URL=postgresql+psycopg://relevo:relevo@localhost:5432/relevo_test

# Autenticação JWT (F4-T01)
JWT_SECRET=relevo-segredo-desenvolvimento-trocar-em-producao
JWT_EXPIRE_HOURS=168

# Storage: `local` (padrão, grava em STORAGE_DIR) ou `s3` (MinIO / S3 / Cloudflare R2 — F4-T08)
STORAGE_TIPO=local
STORAGE_DIR=./storage
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=relevo
S3_SECRET_KEY=relevo-minio-dev
S3_BUCKET=relevo
S3_REGION=us-east-1

CORS_ORIGINS=["http://localhost:5173"]
